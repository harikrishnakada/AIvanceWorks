# ─── Site & Branding ──────────────────────────────────────────────────────────
# Every brand string the site renders comes from here. All are NEXT_PUBLIC_* and
# are inlined at BUILD time (all routes are statically prerendered), so changing
# one needs a rebuild, not just a restart. Each falls back to the value in
# src/lib/constants.ts when unset or empty.
#
# IMPORTANT: NEXT_PUBLIC_SITE_URL drives every canonical, OG URL and sitemap
# entry. If a production build inherits a localhost value, the whole site ships
# localhost canonicals. Set it explicitly in the deploy environment.
NEXT_PUBLIC_SITE_URL=https://aivanceworks.com

# Public brand name. Rendered in <title>, Organization schema, and the logo
# wordmark — the first word becomes the primary mark, the rest the subtitle
# (e.g. "DS Software" → "DS" over "SOFTWARE").
NEXT_PUBLIC_SITE_NAME=

# Short abbreviation shown inside the logo tile and used as the navigation
# label prefix (e.g. "DS").
NEXT_PUBLIC_BRAND_PREFIX=

# Registered entity name — used in the footer copyright and legal copy.
NEXT_PUBLIC_COMPANY_LEGAL_NAME=

NEXT_PUBLIC_SITE_DESCRIPTION=
NEXT_PUBLIC_COMPANY_SLOGAN=

# Social profiles (Organization schema `sameAs` + footer icons)
NEXT_PUBLIC_TWITTER_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_GITHUB_URL=
NEXT_PUBLIC_TWITTER_HANDLE=

# Company contact details (ContactPoint / LocalBusiness schema)
NEXT_PUBLIC_COMPANY_PHONE=
NEXT_PUBLIC_COMPANY_STREET=
NEXT_PUBLIC_COMPANY_CITY=
NEXT_PUBLIC_COMPANY_STATE=
NEXT_PUBLIC_COMPANY_ZIP=
NEXT_PUBLIC_COMPANY_COUNTRY=

NEXT_PUBLIC_SUPPORT_EMAIL=

# Analytics
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_CLARITY_ID=

# Email Provider Configuration
EMAIL_PROVIDER=resend                      # Options: resend, sendgrid, postmark
RESEND_API_KEY=                           # Get from https://resend.com/api-keys
EMAIL_FROM_ADDRESS=notifications@devsolve.io

# Email Addresses
NEXT_PUBLIC_CONTACT_EMAIL=devsolve@gmail.com

# CMS (Sanity)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
SANITY_API_TOKEN=

# Booking Provider Configuration
BOOKING_PROVIDER=calcom                    # Options: calcom, calendly
NEXT_PUBLIC_CALCOM_USERNAME=devsolve   # Your Cal.com username (from URL: cal.com/{username}/...)
CALCOM_EVENT_TYPE=discovery-call           # Cal.com event type slug

# Rate Limiting
RATE_LIMIT_ENABLED=true

# Database (Supabase - if needed)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
